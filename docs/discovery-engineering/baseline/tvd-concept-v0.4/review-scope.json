{
  "version": "concept-review-1.0",
  "project": {
    "id": "TVD_COMPLETE_DISCOVERY",
    "name": "Philadelphia health-tech discovery",
    "question": "Can regional people and work be discovered, qualified, connected, found, sorted and understood across independent sources?",
    "boundary": "Nine-county DVRPC health-tech discovery, explicit mathematical contracts and an implementation plan. No application or operational change.",
    "basis": "DIRECTION"
  },
  "sources": {
    "DIRECTION": "d37b58f7d2bc70baeed077b86923613ee78eeb54b51f41155fc40c60ed1f7039",
    "DESIGN": "7ad2c26d59d0bf458480e16b425e35ca14cac53a0fa89639c3c8d52f111d7de0"
  },
  "topics": {
    "focus": {
      "applicability": "included",
      "rationale": "Retain health-tech, health-informatics and health-AI scope, independent source paths and deferred patents."
    },
    "identity": {
      "applicability": "included",
      "rationale": "Discover regional people and organizations; retain project, artifact and account identities and dated regional roles."
    },
    "evidence": {
      "applicability": "included",
      "rationale": "Retain evidence capture, eligibility, review and typed public delivery."
    },
    "support": {
      "applicability": "included",
      "rationale": "Retain source registry and operator review roles without assigning a new external party."
    },
    "lifecycle": {
      "applicability": "included",
      "rationale": "Retain refresh failures, ambiguity and legacy compatibility during transition."
    },
    "evaluation": {
      "applicability": "included",
      "rationale": "Plan checks for repository discovery, links, attribution, refresh and compatibility."
    },
    "physical_facilities": {
      "applicability": "excluded",
      "rationale": "This increment proposes no physical equipment, facility or host change."
    },
    "patent_implementation": {
      "applicability": "excluded",
      "rationale": "The user deferred patent collection, pages and release obligations."
    },
    "discovery": {
      "applicability": "included",
      "rationale": "Independent code, paper, preprint, forum and institutional discovery; bidirectional creator/work exploration."
    },
    "presentation": {
      "applicability": "included",
      "rationale": "Explicit find, sort and display functions with stable snapshots and supported user-facing claims."
    },
    "proof": {
      "applicability": "included",
      "rationale": "Retain formal obligations and separate empirical evidence requirements."
    }
  },
