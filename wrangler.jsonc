{
  "name": "the-valley-desk",
  "account_id": "1e5f92087e779df50f3f3546a0eed22e",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "thevalleydesk.org", "custom_domain": true },
    { "pattern": "www.thevalleydesk.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "send_email": [
    {
      "name": "NOTIFY_OPS",
      "destination_address": "clyons@ajhcs.org",
      "allowed_sender_addresses": ["alerts@thevalleydesk.org"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "17 3 * * *", "2-57/5 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://thevalleydesk.org",
    "OPS_ACCESS_ISSUER": "https://snowy-breeze-ef37.cloudflareaccess.com",
    "OPS_ACCESS_AUDIENCE": "d96a04c61d789e78abd6349b0db197b92f2c1298e72398246a640ef7ca9028cd",
    "BUILD_SHA": "dev",
    "WATCH_PUBLIC_ENABLED": "true",
    "WATCH_COLLECTION_ENABLED": "true",
    "WATCH_SOURCE_RULE_ENABLED": "true",
    "POLICY_BACKGROUND_PUBLIC_ENABLED": "false",
    "EVENT_CALENDAR_COLLECTION_ENABLED": "true",
    "EVENT_CALENDAR_PUBLIC_ENABLED": "true",
    "EDITOR_MODEL": "meta/muse-spark-1.3-contributor",
    "EDITOR_MODEL_BASE_URL": "https://openrouter.ai/api/v1",
    "EDITOR_MODEL_BUDGET": "32",
    "EDITOR_MODEL_CONCURRENCY": "4",
    "EDITOR_MODEL_TIMEOUT_MS": "45000",
    "EDITOR_MODEL_DEADLINE_MS": "110000"
  },
  "d1_databases": [
    {
      "binding": "VALLEY_DESK_DB",
      "database_name": "the-valley-desk",
      "database_id": "b2dbcf15-4cbd-4189-8775-a2f51e8eb014",
      "migrations_dir": "migrations"
    }
  ]
}
