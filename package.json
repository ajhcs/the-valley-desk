{
  "name": "the-valley-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/build-feed.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --var BUILD_SHA:$(git rev-parse HEAD)",
    "feed": "tsx scripts/build-feed.mjs",
    "ingest:rss": "tsx scripts/ingest-rss.mjs",
    "ingest:events": "tsx scripts/ingest-events.mjs",
    "ingest:social": "tsx scripts/ingest-social.mjs",
    "ingest:all": "tsx scripts/ingest-all.mjs",
    "test": "node --import tsx/esm --test --test-concurrency=1 test/query-contracts.test.ts test/cloudflare-ops.test.ts test/brand-prod.test.ts",
    "ops:smoke": "node --import tsx/esm scripts/ops-smoke.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.31",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
